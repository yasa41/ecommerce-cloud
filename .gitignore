# ==========================================
# NEXORA – .gitignore
# ==========================================

# ---- Dependencies ----
node_modules/
frontend/node_modules/
backend/node_modules/
infrastructure/node_modules/

# ---- Environment & Secrets (NEVER commit these) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
backend/.env
backend/.env.local
infrastructure/.env

# ---- Production Build Outputs ----
frontend/dist/
frontend/build/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ---- Runtime & Cache ----
.cache/
.vite/
frontend/.vite/
dist/
build/
*.tsbuildinfo

# ---- Fallback JSON Data Store (auto-generated by backend) ----
backend/data_store.json

# ---- OS Generated Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editor & IDE ----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ---- Google Cloud / GCP ----
.gcloudignore
gcloud-service-key.json
service-account*.json
*-credentials.json

# ---- Docker ----
# (keep Dockerfile and .dockerignore, ignore local overrides)
docker-compose.override.yml

# ---- Misc ----
*.pem
*.key
*.cert
*.p12
coverage/
.nyc_output/
